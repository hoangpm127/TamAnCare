DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tam_an_care?schema=public"
SESSION_SECRET="replace-with-a-random-32-byte-secret-before-production"
RATE_LIMIT_SECRET="replace-with-a-different-random-32-byte-secret-before-production"
BUSINESS_QR_SECRET="replace-with-a-third-random-32-byte-secret-for-business-qr"
# Chỉ dùng false khi chạy HTTP trong mạng cục bộ; Railway/production phải đặt true.
SESSION_COOKIE_SECURE="false"
# Phân biệt local, uat và production cho cổng kiểm tra triển khai.
APP_ENV="local"
ENABLE_UAT_PAYMENT_SIMULATION="false"
# Chỉ bật trên tên miền HTTPS production (Railway/custom domain).
FORCE_HTTPS="false"

# Customer social login. Keep real secrets in local/Railway variables only.
# Production callbacks:
# https://tamancare-production.up.railway.app/api/customer-auth/oauth/google/callback
# https://tamancare-production.up.railway.app/api/customer-auth/oauth/facebook/callback
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_GRAPH_API_VERSION="v25.0"
# Chỉ bật true sau khi Meta Business Verification hoàn tất và ứng dụng đã được phát hành.
FACEBOOK_LOGIN_PUBLIC="false"
# Recommended separate key; falls back to SESSION_SECRET when empty.
OAUTH_STATE_SECRET=""

# Thông tin công khai dùng để tạo VietQR. Bản local có thể dùng cấu hình demo;
# UAT/production phải khai báo rõ và được đối chiếu với SEPAY_ACCOUNT_NUMBERS.
NEXT_PUBLIC_PAYMENT_BANK_ID=""
NEXT_PUBLIC_PAYMENT_BANK_NAME=""
NEXT_PUBLIC_PAYMENT_ACCOUNT_NUMBER=""
NEXT_PUBLIC_PAYMENT_ACCOUNT_HOLDER=""

# Webhook đối soát ngân hàng. Lấy secret HMAC trong trang cấu hình webhook SePay.
SEPAY_WEBHOOK_SECRET=""
# Danh sách số tài khoản được phép nhận, phân tách bằng dấu phẩy.
SEPAY_ACCOUNT_NUMBERS=""

# Secret Bearer để tác vụ định kỳ dọn booking hết 15 phút giữ chỗ.
CRON_SECRET=""

# Tùy chọn: AI đọc ảnh bill chi phí. Nếu để trống, chứng từ vẫn được lưu và Admin nhập thủ công.
OPENAI_API_KEY=""
# Mặc định dùng gpt-5.6-luna cho tác vụ trích xuất ảnh có cấu trúc, chi phí thấp.
OPENAI_EXPENSE_MODEL="gpt-5.6-luna"

# Bật sau khi đã có một kênh gửi thật. Khi false, booking vãng lai và tài khoản cũ
# vẫn hoạt động; các voucher yêu cầu xác minh chưa bị chặn.
PHONE_VERIFICATION_REQUIRED="false"
# Đăng ký thường và đăng ký qua Google không cần OTP; quyền lợi/affiliate vẫn khóa
# cho tới khi khách xác minh số trong tài khoản.
PHONE_VERIFICATION_ON_SIGNUP_REQUIRED="false"
# ESMS dùng đầu số cố định (SmsType 8) lúc ra mắt; đổi sang 2 + Brandname sau này.
OTP_PROVIDER="DISABLED"
ESMS_API_KEY=""
ESMS_SECRET_KEY=""
ESMS_SMS_TYPE="8"
ESMS_BRANDNAME=""
# Chỉ true khi thử API eSMS: request hợp lệ nhưng không gửi SMS và không tính phí.
ESMS_SANDBOX="true"
# Chỉ bật sau khi eSMS duyệt đúng mẫu OTP và đã nhận được tin thử đúng nội dung.
ESMS_TEMPLATES_APPROVED="false"
ESMS_CALLBACK_URL=""
ESMS_CALLBACK_TOKEN=""
# Phương án gateway nội bộ thay cho ESMS trực tiếp. Không ghi OTP vào log ứng dụng.
OTP_DELIVERY_WEBHOOK_URL=""
OTP_DELIVERY_WEBHOOK_TOKEN=""
# Chỉ dùng trong local/CI, đúng 6 chữ số; bị vô hiệu hóa khi NODE_ENV=production.
PHONE_OTP_TEST_CODE=""
# Chỉ dùng trong local/CI, đúng 8 chữ số; bị vô hiệu hóa khi NODE_ENV=production.
AUTH_OTP_TEST_CODE=""

# Khóa AES-256 riêng để mã hóa TOTP secret: 32 byte ở dạng Base64.
MFA_ENCRYPTION_KEY=""
# Đặt required-management sau khi Owner và Quản lý đã sẵn sàng enrollment.
ADMIN_MFA_ENFORCEMENT="optional"

# Giám sát và lưu ảnh quy mô lớn (không bắt buộc ở local, bắt buộc chốt trước production).
SENTRY_DSN=""
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""

# Chỉ dùng khi chủ động tạo bộ tài khoản kiểm thử trên CSDL UAT.
UAT_PROVISION_CONFIRMATION=""
UAT_NEW_CUSTOMER_PHONE=""
UAT_AFFILIATE_CUSTOMER_PHONE=""

# Chỉ cấu hình các biến dưới đây trên CSDL demo cục bộ. Không chạy seed ở production.
ALLOW_DESTRUCTIVE_SEED=""
SEED_OWNER_PASSWORD=""
SEED_MANAGER_CS1_PASSWORD=""
SEED_MANAGER_CS2_PASSWORD=""
SEED_RECEPTION_CS1_PASSWORD=""
SEED_RECEPTION_CS2_PASSWORD=""
SEED_INVESTOR_PASSWORD=""
SEED_THERAPIST_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""
