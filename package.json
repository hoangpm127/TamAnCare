{
  "name": "tam-an-center",
  "version": "1.8.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "demo": "pglite-server --db=.pglite-data --port=5432 --host=127.0.0.1 --max-connections=50 --run \"next dev\" --include-database-url",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:start:demo": "pglite-server --db=.pglite-data --port=5432 --host=127.0.0.1 --max-connections=50",
    "demo:sync-accounts": "tsx scripts/sync-demo-account-passwords.ts",
    "test:core": "tsx scripts/verify-core-flows.ts",
    "test:expenses": "tsx scripts/verify-expense-evidence.ts",
    "test:refunds": "tsx scripts/verify-refund-workflow.ts",
    "test:security": "tsx scripts/verify-account-security.ts",
    "test:business": "tsx scripts/verify-business-flow.ts",
    "test:xgroup": "tsx scripts/verify-xgroup-distribution.ts",
    "test:affiliate": "tsx scripts/verify-affiliate-policy.ts",
    "test:scheduling": "tsx scripts/verify-scheduling-policy.ts",
    "test:capacity": "tsx scripts/verify-tam-an-room-capacity.ts",
    "test:therapists": "tsx scripts/verify-therapist-management.ts",
    "test:catalog": "tsx scripts/verify-tam-an-service-catalog.ts",
    "test:i18n": "tsx scripts/verify-customer-translations.ts",
    "test:data-boundaries": "tsx scripts/verify-production-data-boundaries.ts",
    "test:flows": "npm run test:data-boundaries && npm run test:scheduling && npm run test:core && npm run test:expenses && npm run test:refunds && npm run test:security && npm run test:business && npm run test:xgroup",
    "uat:accounts": "tsx scripts/provision-uat-accounts.ts",
    "uat:business-demo": "tsx scripts/provision-business-demo.ts",
    "uat:xgroup": "tsx scripts/provision-xgroup-control.ts",
    "uat:archive-stale-business": "tsx scripts/archive-stale-uat-business.ts",
    "audit:affiliate": "tsx scripts/audit-affiliate-readiness.ts",
    "uat:readiness": "tsx scripts/verify-deployment-readiness.ts --mode=uat",
    "prod:readiness": "tsx scripts/verify-deployment-readiness.ts --mode=production",
    "job:maintenance": "node scripts/invoke-maintenance-job.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.17.1",
    "lucide-react": "^1.23.0",
    "next": "^16.3.0",
    "oauth4webapi": "3.8.6",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "8.5.25",
    "valibot": "1.4.2",
    "sharp": "0.35.0",
    "js-yaml": "4.3.1",
    "@hono/node-server": "2.0.11"
  }
}
